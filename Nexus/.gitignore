# ════════════════════════════════════════════════════
#  Nexus (CivicSync) — Vite + React + TypeScript
#  .gitignore — keep repo clean for live deployment
# ════════════════════════════════════════════════════

# ── Node / npm ──
node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Build output (generated by 
pm run build) ──
# Keep dist/ OUT of git — deploy directly from CI/CD
# (e.g. Vercel / Netlify auto-builds from source)
dist/
dist-ssr/

# ── Vite / TypeScript cache ──
*.local
.vite/
tsconfig.tsbuildinfo
*.tsbuildinfo

# ── Environment variables (NEVER commit secrets) ──
.env
.env.*
!.env.example
!.env.template

# ── Logs ──
logs/
*.log
*.log.*

# ── Coverage / test output ──
coverage/
.nyc_output/

# ── macOS ──
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# ── Windows ──
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Editor / IDE ──
.vscode/settings.json
.vscode/*.code-workspace
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# ── Storybook ──
storybook-static/

# ── Temp / scratch ──
*.tmp
*.temp
*.bak
